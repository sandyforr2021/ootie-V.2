{
  "manifest_version": 3,
  "name": "OOTIE — Shopping Companion",
  "version": "1.1.0",
  "description": "Review a product from the current page and bring it into your OOTIE shopping studio.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open OOTIE Shopping Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
