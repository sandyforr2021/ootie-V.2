# Competition default: no Google calls, no paid fallback, no automatic credit purchase.
OOTIE_COMPETITION_MODE=true
YOUCAM_API_KEY=
# Exact expiry timestamp (milliseconds) of the verified FREE bonus batch.
# The gateway checks its live balance and published feature cost before every task POST.
YOUCAM_FREE_CREDIT_EXPIRY_MS=0
YOUCAM_ENABLED=false
# Comma-separated Supabase auth user UUIDs allowed to use the reviewer reserve.
YOUCAM_REVIEWER_USER_IDS=
# Run on a persistent local/server process. Cloud Run request-only CPU is not a durable worker.
YOUCAM_WORKER_ENABLED=false
# Free-credit ceiling and expiry must also be verified and set in ootie_youcam_budget.

# Legacy Google settings, only read when OOTIE_COMPETITION_MODE=false.
GOOGLE_CLOUD_PROJECT=your-credit-backed-project-id
GOOGLE_CLOUD_LOCATION_STYLING=global
GOOGLE_CLOUD_LOCATION_VTO=asia-southeast1
GOOGLE_CLOUD_LOCATION_IMAGE=global
GOOGLE_STYLING_MODEL=gemini-3.5-flash
GOOGLE_VTO_MODEL=virtual-try-on-001
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# Cost controls. Keep disabled until the live-smoke preflight is approved.
AI_IMAGE_GENERATION_ENABLED=false
AI_MAX_IMAGES_PER_USER_PER_DAY=3
AI_QUOTA_EXEMPT_USER_IDS=
AI_QUOTA_TIMEZONE=Asia/Taipei
AI_IMAGE_OUTPUT_SIZE=1K
AI_ESTIMATED_COST_VTO_USD=
AI_ESTIMATED_COST_OUTFIT_PREVIEW_USD=
VTO_POINTS_COST=8
OUTFIT_PREVIEW_POINTS_COST=12

# Supabase server settings. SUPABASE_SERVICE_ROLE_KEY is a Cloud Run secret,
# never a VITE_* variable and never committed with a real value.
OOTIE_SUPABASE_PROJECT_REF=hoxkrmadzjnyjaqjbyxc
SUPABASE_URL=https://hoxkrmadzjnyjaqjbyxc.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=server-secret-from-secret-manager
SUPABASE_AI_BUCKET=ootie-ai-private

# Comma-separated exact browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
